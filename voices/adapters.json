{
  "_about": "Pick an adapter by name: python voices/serve.py <name>. Keys are never stored here; each adapter reads its key from the environment variable named below. {python} is the Python running serve.py; {adapters} is voices/adapters.",
  "default": "openai",
  "adapters": {
    "openai": {
      "cmd": ["{python}", "{adapters}/openai_compatible.py"],
      "model": "gpt-5.4-mini",
      "effort": "low",
      "options": {"base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY"}
    },
    "openrouter": {
      "cmd": ["{python}", "{adapters}/openai_compatible.py"],
      "model": "openai/gpt-5.4-mini",
      "effort": "default",
      "options": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY"}
    },
    "local": {
      "cmd": ["{python}", "{adapters}/openai_compatible.py"],
      "model": "llama3.1",
      "effort": "default",
      "timeout_s": 180,
      "options": {"base_url": "http://127.0.0.1:11434/v1", "api_key_env": "LOCAL_API_KEY"}
    },
    "anthropic": {
      "cmd": ["{python}", "{adapters}/anthropic_api.py"],
      "model": "claude-opus-5-5",
      "effort": "low",
      "options": {"max_tokens": 2000, "fallbacks": "default"}
    },
    "codex": {
      "cmd": ["node", "{adapters}/codex/adapter.mjs"],
      "model": "gpt-6-astra",
      "effort": "low",
      "timeout_s": 120,
      "page_timeout_ms": 60000,
      "options": {"executable": "codex", "timeout_ms": 110000}
    }
  }
}
